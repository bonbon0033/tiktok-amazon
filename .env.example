# TikTok developer app credentials (https://developers.tiktok.com/)
# Used by scripts/tiktok-auth.mjs and mcp-servers/tiktok-mcp.mjs
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# TikTok handle to embed in Linktree (start with @)
HANDLE=@your_handle

# Optional: Ollama endpoint for agents (defaults to localhost:11434)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
